# ---- storage server (Path A) -------------------------------------------------
# disk | s3 | r2 | minio
MM_STORAGE=disk
# Public URL that serves the uploaded files (must be https in production)
MM_PUBLIC_BASE_URL=http://localhost:8787
# Shared secret the builder sends to upload (generate with: openssl rand -hex 32)
MM_UPLOAD_TOKEN=change-me
# Where disk storage keeps files
MM_DATA_DIR=./.data/files

# S3-compatible (only when MM_STORAGE is s3 | r2 | minio)
MM_S3_ENDPOINT=
MM_S3_REGION=auto
MM_S3_BUCKET=mailmotion
MM_S3_ACCESS_KEY_ID=
MM_S3_SECRET_ACCESS_KEY=

# ---- GitHub publishing (Path B) ---------------------------------------------
# Public values used by the builder
NEXT_PUBLIC_GITHUB_APP_CLIENT_ID=
NEXT_PUBLIC_GITHUB_APP_SLUG=
NEXT_PUBLIC_PUBLISH_FN_URL=http://localhost:8788
# Secret values used by apps/publish-fn only
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
ALLOWED_ORIGINS=http://localhost:3000

# ---- analytics (optional, cookieless) ---------------------------------------
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
