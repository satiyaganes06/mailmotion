# =============================================================================
# MailMotion self-hosting. Copy to .env and edit. Never commit .env.
# =============================================================================

# ---- domains (Caddy issues HTTPS certificates automatically) -------------------
MM_DOMAIN=localhost
MM_IMG_DOMAIN=img.localhost

# ---- storage server (Path A) ------------------------------------------------------
# disk | s3 | r2 | minio | supabase
MM_STORAGE=disk
# Public URL that serves the uploaded images (must be https in production).
MM_PUBLIC_BASE_URL=https://img.localhost
# Shared secret the builder sends to upload. At least 16 characters:  openssl rand -hex 32
MM_UPLOAD_TOKEN=
# Origins allowed to call the upload API from a browser: your builder's address.
MM_ALLOWED_ORIGINS=https://localhost
# Where disk storage keeps files when running outside Docker.
MM_DATA_DIR=./.data/files
# Set to 1 when running behind a reverse proxy so rate limits use X-Forwarded-For.
MM_TRUST_PROXY=0

# S3-compatible (only for MM_STORAGE=s3 | r2 | minio | supabase). r2, minio and supabase also
# need MM_S3_ENDPOINT (supabase: https://<project-ref>.supabase.co/storage/v1/s3, see docs/self-hosting.md).
MM_S3_ENDPOINT=
MM_S3_REGION=auto
MM_S3_BUCKET=mailmotion
MM_S3_ACCESS_KEY_ID=
MM_S3_SECRET_ACCESS_KEY=

# ---- GitHub Pages publishing (Path B, optional) ---------------------------------
# The client ID is public and is built into the site. The secret stays on the function only.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
NEXT_PUBLIC_GITHUB_APP_SLUG=
NEXT_PUBLIC_PUBLISH_FN_URL=
# Local development against apps/mock-github (see docs/github-pages):
# NEXT_PUBLIC_GITHUB_OAUTH_BASE=http://localhost:8790
# NEXT_PUBLIC_GITHUB_API_BASE=http://localhost:8790
# NEXT_PUBLIC_GITHUB_PAGES_TEMPLATE=http://localhost:8790/pages/{owner}/{repo}

# ---- site analytics (optional, cookieless: Plausible or Umami) --------------------
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
